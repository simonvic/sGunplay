FrameWidgetClass sCrosshair_root {
 clipchildren 0
 ignorepointer 1
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 scaled 1
 {
  ImageWidgetClass img_staticCrosshair {
   visible 0
   inheritalpha 0
   ignorepointer 1
   size 64 64
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   scaled 1
   image0 "set:sCrosshairs image:dot"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "flip u" 0
   "flip v" 0
  }
  FrameWidgetClass c_dynamicCrosshair {
   visible 1
   clipchildren 0
   ignorepointer 1
   position 0 0
   size 64 64
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   {
    ImageWidgetClass img_dynamicCrosshair {
     visible 0
     inheritalpha 0
     ignorepointer 1
     position -32 -32
     size 64 64
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     image0 "set:sCrosshairs image:curve"
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "flip u" 0
     "flip v" 0
    }
   }
  }
 }
}